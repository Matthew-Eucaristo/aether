(module
  (import "world" "self" (func $self (result i64)))
  (import "world" "entity" (func $entity (param i32) (result i64)))
  (import "world" "exists" (func $exists (param i64) (result i32)))
  (import "world" "kind" (func $kind (param i64 i32 i32) (result i32)))
  (import "world" "get_num" (func $get (param i64 i32 i32) (result f64)))
  (import "world" "get_nums" (func $get_nums (param i64 i32 i32 i32 i32) (result i32)))
  (import "world" "get_text" (func $get_text (param i64 i32 i32 i32 i32) (result i32)))
  (import "world" "set_num" (func $set (param i32 i32 i32 f64)))
  (import "world" "set_nums" (func $set_nums (param i32 i32 i32 i32 i32)))
  (import "world" "set_text" (func $set_text (param i32 i32 i32 i32 i32)))
  (import "world" "set_bool" (func $set_bool (param i32 i32 i32 i32)))
  (import "world" "spawn" (func $spawn (result i32)))
  (import "world" "despawn" (func $despawn (param i32)))
  (import "world" "signal_find" (func $signal_find (param i32 i32 i64 i32) (result i32)))
  (import "world" "signal_entity" (func $signal_entity (param i32) (result i64)))
  (import "world" "signal_from" (func $signal_from (param i32 i32 i32) (result i32)))
  (import "world" "owner" (func $owner (param i64 i32 i32) (result i32)))
  (import "world" "random" (func $random (result i64)))
  (memory (export "memory") 1)
  (global $body (mut i64) (i64.const -1))
  (data (i32.const 0) "init")
  (data (i32.const 8) "gun")
  (data (i32.const 16) "live")
  (data (i32.const 24) "aim.x")
  (data (i32.const 32) "aim.y")
  (data (i32.const 40) "aim.z")
  (data (i32.const 48) "pos.x")
  (data (i32.const 56) "pos.y")
  (data (i32.const 64) "pos.z")
  (data (i32.const 72) "vel.x")
  (data (i32.const 80) "vel.y")
  (data (i32.const 88) "vel.z")
  (data (i32.const 96) "weapon")
  (data (i32.const 104) "fire")
  (data (i32.const 112) "hit")
  (data (i32.const 120) "projectile")
  (data (i32.const 136) "from")
  (data (i32.const 144) "dir.x")
  (data (i32.const 152) "dir.y")
  (data (i32.const 160) "dir.z")
  (data (i32.const 168) "shape")
  (data (i32.const 176) "box")
  (data (i32.const 184) "scale.x")
  (data (i32.const 192) "scale.y")
  (data (i32.const 200) "scale.z")
  (data (i32.const 208) "color")
  (data (i32.const 216) "#2b2f36")
  (data (i32.const 224) "#ffd27a")
  (data (i32.const 232) "glow")
  (data (i32.const 240) "light")
  (data (i32.const 248) "size")
  (data (i32.const 256) "solid")
  (data (i32.const 264) "sound.wave")
  (data (i32.const 280) "noise")
  (data (i32.const 288) "sound.gain")
  (data (i32.const 304) "sound.on")
  (data (i32.const 312) "sound.freq")
  (data (i32.const 328) "cool")
  (data (i32.const 344) "player")

  (global $SLOT f64 (f64.const 1))
  (global $DAMAGE f64 (f64.const 8))
  (global $SPEED f64 (f64.const 4))
  (global $TTL f64 (f64.const 12))
  (global $COOLDOWN f64 (f64.const 1))
  (global $LIVE i32 (i32.const 1024))

  (func $num (param $id i64) (param $k i32) (param $l i32) (param $d f64) (result f64)
    (if (result f64) (i32.eq (call $kind (local.get $id) (local.get $k) (local.get $l)) (i32.const 1))
      (then (call $get (local.get $id) (local.get $k) (local.get $l)))
      (else (local.get $d))))

  (func $rand (result f64)
    (f64.mul (f64.convert_i64_u (i64.shr_u (call $random) (i64.const 11))) (f64.const 1.1102230246251565e-16)))

  (func $same (param $a i32) (param $b i32) (result i32)
    (local $i i32)
    (if (i32.or (i32.ne (local.get $a) (local.get $b)) (i32.gt_u (local.get $a) (i32.const 64)))
      (then (return (i32.const 0))))
    (block $diff
      (loop $cmp
        (br_if $diff (i32.ge_u (local.get $i) (local.get $a)))
        (if (i32.ne (i32.load8_u (i32.add (i32.const 512) (local.get $i)))
                    (i32.load8_u (i32.add (i32.const 576) (local.get $i))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $cmp)))
    (i32.const 1))

  (func $official (param $s i32) (result i32)
    (call $same (call $signal_from (local.get $s) (i32.const 512) (i32.const 64))
                (call $owner (global.get $body) (i32.const 576) (i32.const 64))))

  (func $official_find (param $name i32) (param $len i32) (param $id i64) (result i32)
    (local $s i32)
    (local.set $s (i32.const -1))
    (block $none
      (loop $next
        (local.set $s (call $signal_find (local.get $name) (local.get $len) (local.get $id) (local.get $s)))
        (br_if $none (i32.lt_s (local.get $s) (i32.const 0)))
        (if (call $official (local.get $s)) (then (return (local.get $s))))
        (br $next)))
    (i32.const -1))

  (func $place (param $h i32) (param $x f64) (param $y f64) (param $z f64)
    (call $set (local.get $h) (i32.const 48) (i32.const 5) (local.get $x))
    (call $set (local.get $h) (i32.const 56) (i32.const 5) (local.get $y))
    (call $set (local.get $h) (i32.const 64) (i32.const 5) (local.get $z)))

  (func $point (param $h i32) (param $x f64) (param $y f64) (param $z f64)
    (call $set (local.get $h) (i32.const 144) (i32.const 5) (local.get $x))
    (call $set (local.get $h) (i32.const 152) (i32.const 5) (local.get $y))
    (call $set (local.get $h) (i32.const 160) (i32.const 5) (local.get $z)))

  (func (export "tick")
    (local $me i64) (local $av i64) (local $gun i32) (local $n i32) (local $i i32) (local $p i32) (local $s i32)
    (local $b i32) (local $id i64) (local $ttl f64) (local $cool f64) (local $fired i32) (local $sel i32)
    (local $ax f64) (local $ay f64) (local $az f64) (local $mx f64) (local $my f64) (local $mz f64) (local $l f64)
    (local $hx f64) (local $hy f64) (local $gx f64) (local $gy f64) (local $gz f64)
    (local $vx f64) (local $vy f64) (local $vz f64)
    (local.set $me (call $self))
    (local.set $av (call $entity (i32.const 1)))
    (global.set $body (local.get $av))
    (if (i32.or (i32.eqz (call $kind (local.get $av) (i32.const 24) (i32.const 5)))
                (i32.ne (call $kind (local.get $av) (i32.const 344) (i32.const 6)) (i32.const 2))) (then (return)))
    (if (i32.eqz (call $kind (local.get $me) (i32.const 0) (i32.const 4)))
      (then
        (call $set (i32.const 0) (i32.const 0) (i32.const 4) (f64.const 1))
        (local.set $gun (call $spawn))
        (call $set (i32.const 0) (i32.const 8) (i32.const 3) (f64.convert_i32_s (local.get $gun)))
        (call $set_text (local.get $gun) (i32.const 168) (i32.const 5) (i32.const 176) (i32.const 3))
        (call $set (local.get $gun) (i32.const 184) (i32.const 7) (f64.const 0.7))
        (call $set (local.get $gun) (i32.const 192) (i32.const 7) (f64.const 0.09))
        (call $set (local.get $gun) (i32.const 200) (i32.const 7) (f64.const 0.13))
        (call $set_text (local.get $gun) (i32.const 208) (i32.const 5) (i32.const 216) (i32.const 7))
        (call $set_bool (local.get $gun) (i32.const 256) (i32.const 5) (i32.const 0))
        (call $set_text (local.get $gun) (i32.const 264) (i32.const 10) (i32.const 280) (i32.const 5))
        (call $set (local.get $gun) (i32.const 288) (i32.const 10) (f64.const 0.35))
        (call $set (local.get $gun) (i32.const 312) (i32.const 10) (f64.const 2400))
        (call $set_bool (local.get $gun) (i32.const 304) (i32.const 8) (i32.const 0))))
    (local.set $gun (i32.trunc_sat_f64_s (call $get (local.get $me) (i32.const 8) (i32.const 3))))

    (local.set $ax (call $num (local.get $av) (i32.const 48) (i32.const 5) (f64.const 0)))
    (local.set $ay (call $num (local.get $av) (i32.const 56) (i32.const 5) (f64.const 0)))
    (local.set $az (call $num (local.get $av) (i32.const 64) (i32.const 5) (f64.const 0.9)))
    (local.set $mx (call $num (local.get $av) (i32.const 24) (i32.const 5) (f64.const 1)))
    (local.set $my (call $num (local.get $av) (i32.const 32) (i32.const 5) (f64.const 0)))
    (local.set $mz (call $num (local.get $av) (i32.const 40) (i32.const 5) (f64.const 0)))
    (local.set $l (f64.sqrt (f64.add (f64.add (f64.mul (local.get $mx) (local.get $mx)) (f64.mul (local.get $my) (local.get $my))) (f64.mul (local.get $mz) (local.get $mz)))))
    (if (f64.lt (local.get $l) (f64.const 1e-6))
      (then (local.set $mx (f64.const 1)) (local.set $my (f64.const 0)) (local.set $mz (f64.const 0)) (local.set $l (f64.const 1))))
    (local.set $mx (f64.div (local.get $mx) (local.get $l)))
    (local.set $my (f64.div (local.get $my) (local.get $l)))
    (local.set $mz (f64.div (local.get $mz) (local.get $l)))
    (local.set $l (f64.sqrt (f64.add (f64.mul (local.get $mx) (local.get $mx)) (f64.mul (local.get $my) (local.get $my)))))
    (local.set $hx (f64.const 1))
    (if (f64.gt (local.get $l) (f64.const 1e-6))
      (then (local.set $hx (f64.div (local.get $mx) (local.get $l))) (local.set $hy (f64.div (local.get $my) (local.get $l)))))
    (local.set $sel (f64.eq (call $num (local.get $av) (i32.const 96) (i32.const 6) (global.get $SLOT)) (global.get $SLOT)))
    (if (local.get $sel)
      (then
        (local.set $gx (f64.add (f64.add (local.get $ax) (f64.mul (local.get $mx) (f64.const 0.55))) (f64.mul (local.get $hy) (f64.const 0.3))))
        (local.set $gy (f64.sub (f64.add (local.get $ay) (f64.mul (local.get $my) (f64.const 0.55))) (f64.mul (local.get $hx) (f64.const 0.3))))
        (local.set $gz (f64.add (f64.add (local.get $az) (f64.const 0.3)) (f64.mul (local.get $mz) (f64.const 0.55))))
        (call $point (local.get $gun) (local.get $mx) (local.get $my) (local.get $mz)))
      (else
        (local.set $gx (f64.sub (local.get $ax) (f64.mul (local.get $hx) (f64.const 0.3))))
        (local.set $gy (f64.sub (local.get $ay) (f64.mul (local.get $hy) (f64.const 0.3))))
        (local.set $gz (f64.add (local.get $az) (f64.const 0.35)))
        (call $point (local.get $gun) (f64.const 0) (f64.const 0) (f64.const 1))))
    (call $place (local.get $gun) (local.get $gx) (local.get $gy) (local.get $gz))

    (local.set $n (i32.const 0))
    (if (i32.eq (call $kind (local.get $me) (i32.const 16) (i32.const 4)) (i32.const 4))
      (then (local.set $n (i32.shr_u (call $get_nums (local.get $me) (i32.const 16) (i32.const 4) (global.get $LIVE) (i32.const 64)) (i32.const 1)))))
    (if (i32.gt_u (local.get $n) (i32.const 32)) (then (local.set $n (i32.const 0))))

    (local.set $s (i32.const -1))
    (block $hits
      (loop $next
        (local.set $s (call $signal_find (i32.const 112) (i32.const 3) (i64.const -1) (local.get $s)))
        (br_if $hits (i32.lt_s (local.get $s) (i32.const 0)))
        (local.set $id (call $signal_entity (local.get $s)))
        (local.set $i (i32.const 0))
        (if (call $official (local.get $s))
          (then
            (block $found
              (loop $scan
                (br_if $found (i32.ge_u (local.get $i) (local.get $n)))
                (local.set $p (i32.add (global.get $LIVE) (i32.shl (local.get $i) (i32.const 4))))
                (if (i64.eq (call $entity (i32.trunc_sat_f64_s (f64.load (local.get $p)))) (local.get $id))
                  (then (f64.store offset=8 (local.get $p) (f64.const 0))))
                (local.set $i (i32.add (local.get $i) (i32.const 1)))
                (br $scan)))))
        (br $next)))

    (local.set $i (i32.const 0))
    (block $moved
      (loop $each
        (br_if $moved (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $p (i32.add (global.get $LIVE) (i32.shl (local.get $i) (i32.const 4))))
        (local.set $b (i32.trunc_sat_f64_s (f64.load (local.get $p))))
        (local.set $ttl (f64.sub (f64.load offset=8 (local.get $p)) (f64.const 1)))
        (if (f64.le (local.get $ttl) (f64.const 0))
          (then
            (call $despawn (local.get $b))
            (local.set $n (i32.sub (local.get $n) (i32.const 1)))
            (f64.store (local.get $p) (f64.load (i32.add (global.get $LIVE) (i32.shl (local.get $n) (i32.const 4)))))
            (f64.store offset=8 (local.get $p) (f64.load offset=8 (i32.add (global.get $LIVE) (i32.shl (local.get $n) (i32.const 4)))))
            (br $each)))
        (f64.store offset=8 (local.get $p) (local.get $ttl))
        (local.set $id (call $entity (local.get $b)))
        (call $place (local.get $b)
          (f64.add (call $get (local.get $id) (i32.const 48) (i32.const 5)) (call $get (local.get $id) (i32.const 72) (i32.const 5)))
          (f64.add (call $get (local.get $id) (i32.const 56) (i32.const 5)) (call $get (local.get $id) (i32.const 80) (i32.const 5)))
          (f64.add (call $get (local.get $id) (i32.const 64) (i32.const 5)) (call $get (local.get $id) (i32.const 88) (i32.const 5))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $each)))

    (local.set $cool (f64.max (f64.const 0) (f64.sub (call $num (local.get $me) (i32.const 328) (i32.const 4) (f64.const 0)) (f64.const 1))))
    (if (i32.and (i32.and (local.get $sel) (f64.le (local.get $cool) (f64.const 0))) (i32.lt_u (local.get $n) (i32.const 32)))
      (then
        (local.set $s (i32.const -1))
        (block $done
          (loop $next
            (local.set $s (call $signal_find (i32.const 104) (i32.const 4) (local.get $av) (local.get $s)))
            (br_if $done (i32.lt_s (local.get $s) (i32.const 0)))
            (if (call $same (call $signal_from (local.get $s) (i32.const 512) (i32.const 64))
                            (call $get_text (local.get $av) (i32.const 344) (i32.const 6) (i32.const 576) (i32.const 64)))
              (then (local.set $fired (i32.const 1)) (br $done)))
            (br $next)))))
    (if (local.get $fired)
      (then
        (local.set $vx (f64.mul (f64.add (local.get $mx) (f64.mul (f64.sub (call $rand) (f64.const 0.5)) (f64.const 0.03))) (global.get $SPEED)))
        (local.set $vy (f64.mul (f64.add (local.get $my) (f64.mul (f64.sub (call $rand) (f64.const 0.5)) (f64.const 0.03))) (global.get $SPEED)))
        (local.set $vz (f64.mul (f64.add (local.get $mz) (f64.mul (f64.sub (call $rand) (f64.const 0.5)) (f64.const 0.03))) (global.get $SPEED)))
        (local.set $b (call $spawn))
        (call $place (local.get $b)
          (f64.add (local.get $gx) (f64.mul (local.get $mx) (f64.const 0.4)))
          (f64.add (local.get $gy) (f64.mul (local.get $my) (f64.const 0.4)))
          (f64.add (local.get $gz) (f64.mul (local.get $mz) (f64.const 0.4))))
        (call $set (local.get $b) (i32.const 72) (i32.const 5) (local.get $vx))
        (call $set (local.get $b) (i32.const 80) (i32.const 5) (local.get $vy))
        (call $set (local.get $b) (i32.const 88) (i32.const 5) (local.get $vz))
        (call $set (local.get $b) (i32.const 248) (i32.const 4) (f64.const 0.07))
        (call $set_text (local.get $b) (i32.const 208) (i32.const 5) (i32.const 224) (i32.const 7))
        (call $set (local.get $b) (i32.const 232) (i32.const 4) (f64.const 3))
        (call $set (local.get $b) (i32.const 120) (i32.const 10) (global.get $DAMAGE))
        (call $set (local.get $b) (i32.const 136) (i32.const 4) (f64.convert_i64_s (local.get $av)))
        (local.set $p (i32.add (global.get $LIVE) (i32.shl (local.get $n) (i32.const 4))))
        (f64.store (local.get $p) (f64.convert_i32_s (local.get $b)))
        (f64.store offset=8 (local.get $p) (global.get $TTL))
        (local.set $n (i32.add (local.get $n) (i32.const 1)))
        (local.set $cool (global.get $COOLDOWN))))
    (call $set (local.get $gun) (i32.const 240) (i32.const 5) (select (f64.const 6) (f64.const 0) (local.get $fired)))
    (call $set_bool (local.get $gun) (i32.const 304) (i32.const 8) (local.get $fired))
    (call $set (i32.const 0) (i32.const 328) (i32.const 4) (local.get $cool))
    (call $set_nums (i32.const 0) (i32.const 16) (i32.const 4) (global.get $LIVE) (i32.shl (local.get $n) (i32.const 1)))))
