(module
  (import "world" "self" (func $self (result i64)))
  (import "world" "entity" (func $entity (param i32) (result i64)))
  (import "world" "exists" (func $exists (param i64) (result i32)))
  (import "world" "kind" (func $kind (param i64 i32 i32) (result i32)))
  (import "world" "get_num" (func $get (param i64 i32 i32) (result f64)))
  (import "world" "get_nums" (func $get_nums (param i64 i32 i32 i32 i32) (result i32)))
  (import "world" "get_text" (func $get_text (param i64 i32 i32 i32 i32) (result i32)))
  (import "world" "set_num" (func $set (param i32 i32 i32 f64)))
  (import "world" "set_nums" (func $set_nums (param i32 i32 i32 i32 i32)))
  (import "world" "set_text" (func $set_text (param i32 i32 i32 i32 i32)))
  (import "world" "set_bool" (func $set_bool (param i32 i32 i32 i32)))
  (import "world" "spawn" (func $spawn (result i32)))
  (import "world" "despawn" (func $despawn (param i32)))
  (import "world" "signal_find" (func $signal_find (param i32 i32 i64 i32) (result i32)))
  (import "world" "signal_entity" (func $signal_entity (param i32) (result i64)))
  (import "world" "signal_value" (func $signal_value (param i32) (result f64)))
  (import "world" "signal_from" (func $signal_from (param i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "init")
  (data (i32.const 8) "tube")
  (data (i32.const 16) "live")
  (data (i32.const 24) "aim.x")
  (data (i32.const 32) "aim.y")
  (data (i32.const 40) "aim.z")
  (data (i32.const 48) "pos.x")
  (data (i32.const 56) "pos.y")
  (data (i32.const 64) "pos.z")
  (data (i32.const 72) "vel.x")
  (data (i32.const 80) "vel.y")
  (data (i32.const 88) "vel.z")
  (data (i32.const 96) "weapon")
  (data (i32.const 104) "fire")
  (data (i32.const 112) "hit")
  (data (i32.const 120) "projectile")
  (data (i32.const 136) "from")
  (data (i32.const 144) "dir.x")
  (data (i32.const 152) "dir.y")
  (data (i32.const 160) "dir.z")
  (data (i32.const 168) "shape")
  (data (i32.const 176) "cylinder")
  (data (i32.const 184) "scale.x")
  (data (i32.const 192) "scale.y")
  (data (i32.const 200) "scale.z")
  (data (i32.const 208) "color")
  (data (i32.const 216) "#4a5a3a")
  (data (i32.const 224) "#ffd6a0")
  (data (i32.const 232) "glow")
  (data (i32.const 240) "light")
  (data (i32.const 248) "size")
  (data (i32.const 256) "solid")
  (data (i32.const 264) "sound.wave")
  (data (i32.const 280) "noise")
  (data (i32.const 288) "sound.gain")
  (data (i32.const 304) "sound.on")
  (data (i32.const 312) "sound.freq")
  (data (i32.const 328) "cool")
  (data (i32.const 336) "blast")
  (data (i32.const 344) "fx")
  (data (i32.const 352) "#ffb35c")
  (data (i32.const 360) "points")
  (data (i32.const 368) "hx")
  (data (i32.const 376) "hy")
  (data (i32.const 384) "hz")
  (data (i32.const 392) "#ff7a1a")
  (data (i32.const 400) "player")

  (global $SLOT f64 (f64.const 2))
  (global $DAMAGE f64 (f64.const 25))
  (global $BLAST f64 (f64.const 4))
  (global $TTL f64 (f64.const 30))
  (global $COOLDOWN f64 (f64.const 12))
  (global $FXAGE f64 (f64.const 9))
  (global $SPARKS i32 (i32.const 48))
  (global $LIVE i32 (i32.const 1024))
  (global $FX i32 (i32.const 1536))
  (global $BUF i32 (i32.const 2048))
  (global $nf (mut i32) (i32.const 0))

  (func $num (param $id i64) (param $k i32) (param $l i32) (param $d f64) (result f64)
    (if (result f64) (i32.eq (call $kind (local.get $id) (local.get $k) (local.get $l)) (i32.const 1))
      (then (call $get (local.get $id) (local.get $k) (local.get $l)))
      (else (local.get $d))))

  (func $same (param $a i32) (param $b i32) (result i32)
    (local $i i32)
    (if (i32.or (i32.ne (local.get $a) (local.get $b)) (i32.gt_u (local.get $a) (i32.const 64)))
      (then (return (i32.const 0))))
    (block $diff
      (loop $cmp
        (br_if $diff (i32.ge_u (local.get $i) (local.get $a)))
        (if (i32.ne (i32.load8_u (i32.add (i32.const 512) (local.get $i)))
                    (i32.load8_u (i32.add (i32.const 576) (local.get $i))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $cmp)))
    (i32.const 1))

  (func $place (param $h i32) (param $x f64) (param $y f64) (param $z f64)
    (call $set (local.get $h) (i32.const 48) (i32.const 5) (local.get $x))
    (call $set (local.get $h) (i32.const 56) (i32.const 5) (local.get $y))
    (call $set (local.get $h) (i32.const 64) (i32.const 5) (local.get $z)))

  (func $point (param $h i32) (param $x f64) (param $y f64) (param $z f64)
    (call $set (local.get $h) (i32.const 144) (i32.const 5) (local.get $x))
    (call $set (local.get $h) (i32.const 152) (i32.const 5) (local.get $y))
    (call $set (local.get $h) (i32.const 160) (i32.const 5) (local.get $z)))

  (func $signal (param $name i32) (param $id i64) (param $d f64) (result f64)
    (local $s i32)
    (local.set $s (call $signal_find (local.get $name) (i32.const 2) (local.get $id) (i32.const -1)))
    (if (result f64) (i32.lt_s (local.get $s) (i32.const 0))
      (then (local.get $d))
      (else (call $signal_value (local.get $s)))))

  (func $explode (param $x f64) (param $y f64) (param $z f64)
    (local $ball i32) (local $sparks i32) (local $p i32)
    (if (i32.ge_u (global.get $nf) (i32.const 8)) (then (return)))
    (local.set $ball (call $spawn))
    (call $place (local.get $ball) (local.get $x) (local.get $y) (local.get $z))
    (call $set_text (local.get $ball) (i32.const 208) (i32.const 5) (i32.const 352) (i32.const 7))
    (call $set_bool (local.get $ball) (i32.const 256) (i32.const 5) (i32.const 0))
    (call $set_text (local.get $ball) (i32.const 264) (i32.const 10) (i32.const 280) (i32.const 5))
    (call $set (local.get $ball) (i32.const 288) (i32.const 10) (f64.const 0.9))
    (call $set (local.get $ball) (i32.const 312) (i32.const 10) (f64.const 260))
    (local.set $sparks (call $spawn))
    (call $place (local.get $sparks) (local.get $x) (local.get $y) (local.get $z))
    (call $set (local.get $sparks) (i32.const 248) (i32.const 4) (f64.const 0.05))
    (call $set_text (local.get $sparks) (i32.const 208) (i32.const 5) (i32.const 392) (i32.const 7))
    (call $set (local.get $sparks) (i32.const 232) (i32.const 4) (f64.const 3))
    (call $set_bool (local.get $sparks) (i32.const 256) (i32.const 5) (i32.const 0))
    (local.set $p (i32.add (global.get $FX) (i32.mul (global.get $nf) (i32.const 24))))
    (f64.store (local.get $p) (f64.convert_i32_s (local.get $ball)))
    (f64.store offset=8 (local.get $p) (f64.convert_i32_s (local.get $sparks)))
    (f64.store offset=16 (local.get $p) (f64.const 0))
    (global.set $nf (i32.add (global.get $nf) (i32.const 1))))

  (func $animate
    (local $i i32) (local $p i32) (local $age f64) (local $k f64) (local $j i32) (local $q i32)
    (local $c f64) (local $s f64) (local $x f64) (local $y f64) (local $t f64) (local $z f64) (local $r f64) (local $ring f64)
    (block $done
      (loop $each
        (br_if $done (i32.ge_u (local.get $i) (global.get $nf)))
        (local.set $p (i32.add (global.get $FX) (i32.mul (local.get $i) (i32.const 24))))
        (local.set $age (f64.add (f64.load offset=16 (local.get $p)) (f64.const 1)))
        (if (f64.ge (local.get $age) (global.get $FXAGE))
          (then
            (call $despawn (i32.trunc_sat_f64_s (f64.load (local.get $p))))
            (call $despawn (i32.trunc_sat_f64_s (f64.load offset=8 (local.get $p))))
            (global.set $nf (i32.sub (global.get $nf) (i32.const 1)))
            (memory.copy (local.get $p) (i32.add (global.get $FX) (i32.mul (global.get $nf) (i32.const 24))) (i32.const 24))
            (br $each)))
        (f64.store offset=16 (local.get $p) (local.get $age))
        (local.set $k (f64.sub (f64.const 1) (f64.div (local.get $age) (global.get $FXAGE))))
        (local.set $q (i32.trunc_sat_f64_s (f64.load (local.get $p))))
        (call $set (local.get $q) (i32.const 248) (i32.const 4) (f64.add (f64.const 0.5) (f64.mul (f64.sqrt (local.get $age)) (f64.const 0.95))))
        (call $set (local.get $q) (i32.const 232) (i32.const 4) (f64.mul (f64.const 3) (local.get $k)))
        (call $set (local.get $q) (i32.const 240) (i32.const 5) (f64.mul (f64.const 70) (f64.mul (local.get $k) (local.get $k))))
        (call $set_bool (local.get $q) (i32.const 304) (i32.const 8) (f64.lt (local.get $age) (f64.const 4)))
        (local.set $r (f64.mul (local.get $age) (f64.const 0.55)))
        (local.set $c (f64.const 1))
        (local.set $s (f64.const 0))
        (local.set $j (i32.const 0))
        (loop $spark
          (local.set $z (f64.sub (f64.const 1) (f64.div (f64.mul (f64.const 2) (f64.add (f64.convert_i32_s (local.get $j)) (f64.const 0.5)))
            (f64.convert_i32_s (global.get $SPARKS)))))
          (local.set $ring (f64.sqrt (f64.max (f64.const 0) (f64.sub (f64.const 1) (f64.mul (local.get $z) (local.get $z))))))
          (local.set $q (i32.add (global.get $BUF) (i32.mul (local.get $j) (i32.const 24))))
          (f64.store (local.get $q) (f64.mul (f64.mul (local.get $c) (local.get $ring)) (local.get $r)))
          (f64.store offset=8 (local.get $q) (f64.mul (f64.mul (local.get $s) (local.get $ring)) (local.get $r)))
          (f64.store offset=16 (local.get $q) (f64.sub (f64.mul (f64.abs (local.get $z)) (local.get $r))
            (f64.mul (f64.const 0.06) (f64.mul (local.get $age) (local.get $age)))))
          (local.set $t (f64.sub (f64.mul (local.get $c) (f64.const -0.7373688780783197)) (f64.mul (local.get $s) (f64.const 0.6754902942615238))))
          (local.set $s (f64.add (f64.mul (local.get $c) (f64.const 0.6754902942615238)) (f64.mul (local.get $s) (f64.const -0.7373688780783197))))
          (local.set $c (local.get $t))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br_if $spark (i32.lt_u (local.get $j) (global.get $SPARKS))))
        (call $set_nums (i32.trunc_sat_f64_s (f64.load offset=8 (local.get $p))) (i32.const 360) (i32.const 6)
          (global.get $BUF) (i32.mul (global.get $SPARKS) (i32.const 3)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $each))))

  (func (export "tick")
    (local $me i64) (local $av i64) (local $tube i32) (local $n i32) (local $i i32) (local $p i32) (local $s i32)
    (local $b i32) (local $id i64) (local $ttl f64) (local $cool f64) (local $fired i32) (local $sel i32)
    (local $ax f64) (local $ay f64) (local $az f64) (local $mx f64) (local $my f64) (local $mz f64) (local $l f64)
    (local $hx f64) (local $hy f64) (local $gx f64) (local $gy f64) (local $gz f64)
    (local $x f64) (local $y f64) (local $z f64) (local $vx f64) (local $vy f64) (local $vz f64)
    (local.set $me (call $self))
    (local.set $av (call $entity (i32.const 1)))
    (if (i32.or (i32.eqz (call $kind (local.get $av) (i32.const 24) (i32.const 5)))
                (i32.ne (call $kind (local.get $av) (i32.const 400) (i32.const 6)) (i32.const 2)))
      (then
        (if (i32.eq (call $kind (local.get $me) (i32.const 344) (i32.const 2)) (i32.const 4))
          (then
            (global.set $nf (i32.div_u (call $get_nums (local.get $me) (i32.const 344) (i32.const 2) (global.get $FX) (i32.const 24)) (i32.const 3)))
            (if (i32.gt_u (global.get $nf) (i32.const 8)) (then (global.set $nf (i32.const 0))))
            (call $animate)
            (call $set_nums (i32.const 0) (i32.const 344) (i32.const 2) (global.get $FX) (i32.mul (global.get $nf) (i32.const 3)))))
        (return)))
    (if (i32.eqz (call $kind (local.get $me) (i32.const 0) (i32.const 4)))
      (then
        (call $set (i32.const 0) (i32.const 0) (i32.const 4) (f64.const 1))
        (local.set $tube (call $spawn))
        (call $set (i32.const 0) (i32.const 8) (i32.const 4) (f64.convert_i32_s (local.get $tube)))
        (call $set_text (local.get $tube) (i32.const 168) (i32.const 5) (i32.const 176) (i32.const 8))
        (call $set (local.get $tube) (i32.const 184) (i32.const 7) (f64.const 0.17))
        (call $set (local.get $tube) (i32.const 192) (i32.const 7) (f64.const 0.17))
        (call $set (local.get $tube) (i32.const 200) (i32.const 7) (f64.const 0.85))
        (call $set_text (local.get $tube) (i32.const 208) (i32.const 5) (i32.const 216) (i32.const 7))
        (call $set_bool (local.get $tube) (i32.const 256) (i32.const 5) (i32.const 0))
        (call $set_text (local.get $tube) (i32.const 264) (i32.const 10) (i32.const 280) (i32.const 5))
        (call $set (local.get $tube) (i32.const 288) (i32.const 10) (f64.const 0.5))
        (call $set (local.get $tube) (i32.const 312) (i32.const 10) (f64.const 700))
        (call $set_bool (local.get $tube) (i32.const 304) (i32.const 8) (i32.const 0))))
    (local.set $tube (i32.trunc_sat_f64_s (call $get (local.get $me) (i32.const 8) (i32.const 4))))
    (if (i32.eq (call $kind (local.get $me) (i32.const 344) (i32.const 2)) (i32.const 4))
      (then (global.set $nf (i32.div_u (call $get_nums (local.get $me) (i32.const 344) (i32.const 2) (global.get $FX) (i32.const 24)) (i32.const 3)))))
    (if (i32.gt_u (global.get $nf) (i32.const 8)) (then (global.set $nf (i32.const 0))))

    (local.set $ax (call $num (local.get $av) (i32.const 48) (i32.const 5) (f64.const 0)))
    (local.set $ay (call $num (local.get $av) (i32.const 56) (i32.const 5) (f64.const 0)))
    (local.set $az (call $num (local.get $av) (i32.const 64) (i32.const 5) (f64.const 0.9)))
    (local.set $mx (call $num (local.get $av) (i32.const 24) (i32.const 5) (f64.const 1)))
    (local.set $my (call $num (local.get $av) (i32.const 32) (i32.const 5) (f64.const 0)))
    (local.set $mz (call $num (local.get $av) (i32.const 40) (i32.const 5) (f64.const 0)))
    (local.set $l (f64.sqrt (f64.add (f64.add (f64.mul (local.get $mx) (local.get $mx)) (f64.mul (local.get $my) (local.get $my))) (f64.mul (local.get $mz) (local.get $mz)))))
    (if (f64.lt (local.get $l) (f64.const 1e-6))
      (then (local.set $mx (f64.const 1)) (local.set $my (f64.const 0)) (local.set $mz (f64.const 0)) (local.set $l (f64.const 1))))
    (local.set $mx (f64.div (local.get $mx) (local.get $l)))
    (local.set $my (f64.div (local.get $my) (local.get $l)))
    (local.set $mz (f64.div (local.get $mz) (local.get $l)))
    (local.set $l (f64.sqrt (f64.add (f64.mul (local.get $mx) (local.get $mx)) (f64.mul (local.get $my) (local.get $my)))))
    (local.set $hx (f64.const 1))
    (if (f64.gt (local.get $l) (f64.const 1e-6))
      (then (local.set $hx (f64.div (local.get $mx) (local.get $l))) (local.set $hy (f64.div (local.get $my) (local.get $l)))))
    (local.set $sel (f64.eq (call $num (local.get $av) (i32.const 96) (i32.const 6) (f64.const 1)) (global.get $SLOT)))
    (if (local.get $sel)
      (then
        (local.set $gx (f64.add (f64.add (local.get $ax) (f64.mul (local.get $mx) (f64.const 0.3))) (f64.mul (local.get $hy) (f64.const 0.32))))
        (local.set $gy (f64.sub (f64.add (local.get $ay) (f64.mul (local.get $my) (f64.const 0.3))) (f64.mul (local.get $hx) (f64.const 0.32))))
        (local.set $gz (f64.add (f64.add (local.get $az) (f64.const 0.55)) (f64.mul (local.get $mz) (f64.const 0.3))))
        (call $point (local.get $tube) (local.get $mx) (local.get $my) (local.get $mz)))
      (else
        (local.set $gx (f64.sub (local.get $ax) (f64.mul (local.get $hx) (f64.const 0.32))))
        (local.set $gy (f64.sub (local.get $ay) (f64.mul (local.get $hy) (f64.const 0.32))))
        (local.set $gz (f64.add (local.get $az) (f64.const 0.25)))
        (call $point (local.get $tube) (f64.mul (local.get $hy) (f64.const 0.4)) (f64.mul (local.get $hx) (f64.const -0.4)) (f64.const 1))))
    (call $place (local.get $tube) (local.get $gx) (local.get $gy) (local.get $gz))

    (if (i32.eq (call $kind (local.get $me) (i32.const 16) (i32.const 4)) (i32.const 4))
      (then (local.set $n (i32.shr_u (call $get_nums (local.get $me) (i32.const 16) (i32.const 4) (global.get $LIVE) (i32.const 32)) (i32.const 1)))))
    (if (i32.gt_u (local.get $n) (i32.const 16)) (then (local.set $n (i32.const 0))))

    (local.set $i (i32.const 0))
    (block $moved
      (loop $each
        (br_if $moved (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $p (i32.add (global.get $LIVE) (i32.shl (local.get $i) (i32.const 4))))
        (local.set $b (i32.trunc_sat_f64_s (f64.load (local.get $p))))
        (local.set $id (call $entity (local.get $b)))
        (local.set $x (call $get (local.get $id) (i32.const 48) (i32.const 5)))
        (local.set $y (call $get (local.get $id) (i32.const 56) (i32.const 5)))
        (local.set $z (call $get (local.get $id) (i32.const 64) (i32.const 5)))
        (local.set $ttl (f64.sub (f64.load offset=8 (local.get $p)) (f64.const 1)))
        (local.set $s (call $signal_find (i32.const 112) (i32.const 3) (local.get $id) (i32.const -1)))
        (if (i32.or (i32.ge_s (local.get $s) (i32.const 0)) (f64.le (local.get $ttl) (f64.const 0)))
          (then
            (call $explode
              (call $signal (i32.const 368) (local.get $id) (local.get $x))
              (call $signal (i32.const 376) (local.get $id) (local.get $y))
              (call $signal (i32.const 384) (local.get $id) (local.get $z)))
            (call $despawn (local.get $b))
            (local.set $n (i32.sub (local.get $n) (i32.const 1)))
            (f64.store (local.get $p) (f64.load (i32.add (global.get $LIVE) (i32.shl (local.get $n) (i32.const 4)))))
            (f64.store offset=8 (local.get $p) (f64.load offset=8 (i32.add (global.get $LIVE) (i32.shl (local.get $n) (i32.const 4)))))
            (br $each)))
        (f64.store offset=8 (local.get $p) (local.get $ttl))
        (local.set $vx (call $get (local.get $id) (i32.const 72) (i32.const 5)))
        (local.set $vy (call $get (local.get $id) (i32.const 80) (i32.const 5)))
        (local.set $vz (call $get (local.get $id) (i32.const 88) (i32.const 5)))
        (local.set $l (f64.sqrt (f64.add (f64.add (f64.mul (local.get $vx) (local.get $vx)) (f64.mul (local.get $vy) (local.get $vy))) (f64.mul (local.get $vz) (local.get $vz)))))
        (if (f64.lt (local.get $l) (f64.const 4.5))
          (then
            (local.set $vx (f64.mul (local.get $vx) (f64.const 1.15)))
            (local.set $vy (f64.mul (local.get $vy) (f64.const 1.15)))
            (local.set $vz (f64.mul (local.get $vz) (f64.const 1.15)))
