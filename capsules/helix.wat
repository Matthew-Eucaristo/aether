(module
  (import "world" "self" (func $self (result i64)))
  (import "world" "entity" (func $entity (param i32) (result i64)))
  (import "world" "kind" (func $kind (param i64 i32 i32) (result i32)))
  (import "world" "get_num" (func $get (param i64 i32 i32) (result f64)))
  (import "world" "set_num" (func $set (param i32 i32 i32 f64)))
  (import "world" "set_text" (func $set_text (param i32 i32 i32 i32 i32)))
  (import "world" "spawn" (func $spawn (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "first")
  (data (i32.const 8) "pos.x")
  (data (i32.const 16) "pos.y")
  (data (i32.const 24) "pos.z")
  (data (i32.const 32) "color")
  (data (i32.const 40) "#7fd1ff")
  (func $place (param $h i32) (param $x f64) (param $y f64) (param $z f64)
    (call $set (local.get $h) (i32.const 8) (i32.const 5) (local.get $x))
    (call $set (local.get $h) (i32.const 16) (i32.const 5) (local.get $y))
    (call $set (local.get $h) (i32.const 24) (i32.const 5) (local.get $z)))
  (func (export "tick")
    (local $me i64) (local $i i32) (local $h i32) (local $first i32) (local $id i64)
    (local $x f64) (local $y f64) (local $z f64) (local $t f64)
    (local.set $me (call $self))
    (if (i32.eqz (call $kind (local.get $me) (i32.const 0) (i32.const 5)))
      (then
        (local.set $x (f64.const 2))
        (loop $spawn
          (local.set $h (call $spawn))
          (if (i32.eqz (local.get $i))
            (then (call $set (i32.const 0) (i32.const 0) (i32.const 5) (f64.convert_i32_s (local.get $h)))))
          (call $place (local.get $h) (local.get $x) (local.get $y) (local.get $z))
          (call $set_text (local.get $h) (i32.const 32) (i32.const 5) (i32.const 40) (i32.const 7))
          (local.set $t (f64.sub (f64.mul (local.get $x) (f64.const 0.7071067811865476))
                                 (f64.mul (local.get $y) (f64.const 0.7071067811865476))))
          (local.set $y (f64.add (f64.mul (local.get $x) (f64.const 0.7071067811865476))
                                 (f64.mul (local.get $y) (f64.const 0.7071067811865476))))
          (local.set $x (local.get $t))
          (local.set $z (f64.add (local.get $z) (f64.const 0.5)))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $spawn (i32.lt_u (local.get $i) (i32.const 8))))))
    (local.set $first (i32.trunc_f64_s (call $get (local.get $me) (i32.const 0) (i32.const 5))))
    (local.set $i (i32.const 0))
    (loop $move
      (local.set $h (i32.add (local.get $first) (local.get $i)))
      (local.set $id (call $entity (local.get $h)))
      (local.set $x (call $get (local.get $id) (i32.const 8) (i32.const 5)))
      (local.set $y (call $get (local.get $id) (i32.const 16) (i32.const 5)))
      (local.set $z (f64.add (call $get (local.get $id) (i32.const 24) (i32.const 5)) (f64.const 0.03)))
      (if (f64.gt (local.get $z) (f64.const 4)) (then (local.set $z (f64.sub (local.get $z) (f64.const 4)))))
      (call $place (local.get $h)
        (f64.sub (f64.mul (local.get $x) (f64.const 0.9987502603949663))
                 (f64.mul (local.get $y) (f64.const 0.04997916927067833)))
        (f64.add (f64.mul (local.get $x) (f64.const 0.04997916927067833))
                 (f64.mul (local.get $y) (f64.const 0.9987502603949663)))
        (local.get $z))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $move (i32.lt_u (local.get $i) (i32.const 8))))))
