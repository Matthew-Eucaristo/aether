  (func $box (param $h i32) (param $x f64) (param $y f64) (param $z f64)
              (param $sx f64) (param $sy f64) (param $sz f64) (param $color i32)
    (call $set_text (local.get $h) (i32.const 8) (i32.const 5) (i32.const 16) (i32.const 3))
    (call $set (local.get $h) (i32.const 24) (i32.const 5) (local.get $x))
    (call $set (local.get $h) (i32.const 32) (i32.const 5) (local.get $y))
    (call $set (local.get $h) (i32.const 40) (i32.const 5) (local.get $z))
    (call $set (local.get $h) (i32.const 48) (i32.const 7) (local.get $sx))
    (call $set (local.get $h) (i32.const 56) (i32.const 7) (local.get $sy))
    (call $set (local.get $h) (i32.const 64) (i32.const 7) (local.get $sz))
    (call $set_text (local.get $h) (i32.const 72) (i32.const 5) (local.get $color) (i32.const 7)))

  (func $sin (param $a f64) (result f64) (local $a2 f64)
    (local.set $a2 (f64.mul (local.get $a) (local.get $a)))
    (f64.mul (local.get $a)
      (f64.sub (f64.const 1)
        (f64.mul (f64.div (local.get $a2) (f64.const 6))
          (f64.sub (f64.const 1)
            (f64.mul (f64.div (local.get $a2) (f64.const 20))
              (f64.sub (f64.const 1) (f64.div (local.get $a2) (f64.const 42)))))))))

  (func $cos (param $a f64) (result f64) (local $a2 f64)
    (local.set $a2 (f64.mul (local.get $a) (local.get $a)))
    (f64.sub (f64.const 1)
      (f64.mul (f64.div (local.get $a2) (f64.const 2))
        (f64.sub (f64.const 1)
          (f64.mul (f64.div (local.get $a2) (f64.const 12))
            (f64.sub (f64.const 1)
              (f64.mul (f64.div (local.get $a2) (f64.const 30))
                (f64.sub (f64.const 1) (f64.div (local.get $a2) (f64.const 56))))))))))

  (func $place_door (param $a f64)
    (call $set (i32.const 7) (i32.const 24) (i32.const 5)
      (f64.add (f64.const -0.95) (f64.mul (call $cos (local.get $a)) (f64.const 0.95))))
    (call $set (i32.const 7) (i32.const 32) (i32.const 5)
      (f64.sub (f64.const -3.6) (f64.mul (call $sin (local.get $a)) (f64.const 0.95))))
    (call $set (i32.const 7) (i32.const 80) (i32.const 5) (f64.neg (local.get $a))))

  (func $itoa (param $n i64) (param $dst i32) (result i32)
    (local $len i32) (local $neg i32) (local $i i32) (local $j i32) (local $t i32)
    (if (i64.lt_s (local.get $n) (i64.const 0))
      (then (local.set $neg (i32.const 1)) (local.set $n (i64.sub (i64.const 0) (local.get $n)))))
    (loop $digits
      (i32.store8 (i32.add (i32.const 1600) (local.get $len))
        (i32.add (i32.const 48) (i32.wrap_i64 (i64.rem_u (local.get $n) (i64.const 10)))))
      (local.set $len (i32.add (local.get $len) (i32.const 1)))
      (local.set $n (i64.div_u (local.get $n) (i64.const 10)))
      (br_if $digits (i64.ne (local.get $n) (i64.const 0))))
    (if (local.get $neg)
      (then (i32.store8 (local.get $dst) (i32.const 45)) (local.set $j (i32.const 1))))
    (local.set $i (local.get $len))
    (loop $copy
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (i32.store8 (i32.add (local.get $dst) (local.get $j))
        (i32.load8_u (i32.add (i32.const 1600) (local.get $i))))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br_if $copy (i32.gt_s (local.get $i) (i32.const 0))))
    (local.get $j))

  (func $apply (param $acc i64) (param $op i32) (param $v i64) (result i64)
    (if (result i64) (i32.eq (local.get $op) (i32.const 45))
      (then (i64.sub (local.get $acc) (local.get $v)))
      (else (if (result i64) (i32.eq (local.get $op) (i32.const 42))
        (then (i64.mul (local.get $acc) (local.get $v)))
        (else (i64.add (local.get $acc) (local.get $v)))))))

  (func $eval (param $p i32) (param $len i32) (result i64)
    (local $i i32) (local $b i32) (local $acc i64) (local $cur i64) (local $op i32)
    (local.set $op (i32.const 43))
    (block $end
      (loop $scan
        (br_if $end (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $b (i32.load8_u (i32.add (local.get $p) (local.get $i))))
        (if (i32.and (i32.ge_u (local.get $b) (i32.const 48)) (i32.le_u (local.get $b) (i32.const 57)))
          (then (local.set $cur (i64.add (i64.mul (local.get $cur) (i64.const 10))
                                         (i64.extend_i32_u (i32.sub (local.get $b) (i32.const 48))))))
          (else (if (i32.or (i32.eq (local.get $b) (i32.const 43))
                     (i32.or (i32.eq (local.get $b) (i32.const 45)) (i32.eq (local.get $b) (i32.const 42))))
            (then
              (local.set $acc (call $apply (local.get $acc) (local.get $op) (local.get $cur)))
              (local.set $op (local.get $b))
              (local.set $cur (i64.const 0))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (call $apply (local.get $acc) (local.get $op) (local.get $cur)))

  (func $screen_text (param $key i32) (param $dst i32) (param $cap i32) (result i32)
    (local $screen i64)
    (local.set $screen (call $entity (i32.const 11)))
    (if (result i32) (call $kind (local.get $screen) (local.get $key) (i32.const 6))
      (then (call $get_text (local.get $screen) (local.get $key) (i32.const 6) (local.get $dst) (local.get $cap)))
      (else (i32.const 0))))

  (func $show
    (local $n i32) (local $r i32)
    (memory.copy (i32.const 1100) (i32.const 320) (i32.const 11))
    (local.set $n (call $screen_text (i32.const 160) (i32.const 1111) (i32.const 40)))
    (if (i32.gt_u (local.get $n) (i32.const 40)) (then (local.set $n (i32.const 0))))
    (local.set $n (i32.add (i32.const 11) (local.get $n)))
    (i32.store8 (i32.add (i32.const 1100) (local.get $n)) (i32.const 10))
    (local.set $n (i32.add (local.get $n) (i32.const 1)))
    (local.set $r (call $screen_text (i32.const 168) (i32.add (i32.const 1100) (local.get $n)) (i32.const 40)))
    (if (i32.gt_u (local.get $r) (i32.const 40)) (then (local.set $r (i32.const 0))))
    (call $set_text (i32.const 11) (i32.const 152) (i32.const 5) (i32.const 1100) (i32.add (local.get $n) (local.get $r))))

  (func $key (param $c i32)
    (local $len i32) (local $n i32)
    (local.set $len (call $screen_text (i32.const 160) (i32.const 1024) (i32.const 32)))
    (if (i32.gt_u (local.get $len) (i32.const 32)) (then (local.set $len (i32.const 0))))
    (if (i32.eq (local.get $c) (i32.const 13))
      (then
        (memory.copy (i32.const 1400) (i32.const 352) (i32.const 2))
        (local.set $n (call $itoa (call $eval (i32.const 1024) (local.get $len)) (i32.const 1402)))
        (call $set_text (i32.const 11) (i32.const 168) (i32.const 6) (i32.const 1400) (i32.add (local.get $n) (i32.const 2)))
        (local.set $len (i32.const 0)))
      (else (if (i32.eq (local.get $c) (i32.const 8))
        (then (if (local.get $len) (then (local.set $len (i32.sub (local.get $len) (i32.const 1))))))
        (else (if (i32.and (i32.lt_u (local.get $len) (i32.const 32))
                (i32.or (i32.and (i32.ge_u (local.get $c) (i32.const 48)) (i32.le_u (local.get $c) (i32.const 57)))
                  (i32.or (i32.or (i32.eq (local.get $c) (i32.const 43)) (i32.eq (local.get $c) (i32.const 45)))
                    (i32.or (i32.eq (local.get $c) (i32.const 42)) (i32.eq (local.get $c) (i32.const 32))))))
          (then
            (i32.store8 (i32.add (i32.const 1024) (local.get $len)) (local.get $c))
            (local.set $len (i32.add (local.get $len) (i32.const 1)))))))))
    (call $set_text (i32.const 11) (i32.const 160) (i32.const 6) (i32.const 1024) (local.get $len))
    (call $set (i32.const 11) (i32.const 176) (i32.const 10) (f64.add (f64.const 660) (f64.convert_i32_u (i32.mul (local.get $c) (i32.const 4)))))
    (call $set_bool (i32.const 11) (i32.const 208) (i32.const 8) (i32.const 1))
    (call $set (i32.const 0) (i32.const 144) (i32.const 5) (f64.add (f64.convert_i64_s (call $tick)) (f64.const 1))))

  (func $build
    (local $i i32)
    (loop $spawn
      (drop (call $spawn))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $spawn (i32.lt_u (local.get $i) (i32.const 11))))
    (call $box (i32.const 1) (f64.const 0) (f64.const -6) (f64.const 0.1) (f64.const 6) (f64.const 5) (f64.const 0.2) (i32.const 256))
    (call $box (i32.const 2) (f64.const 0) (f64.const -8.4) (f64.const 1.6) (f64.const 6) (f64.const 0.2) (f64.const 3) (i32.const 264))
    (call $box (i32.const 3) (f64.const -2.9) (f64.const -6) (f64.const 1.6) (f64.const 0.2) (f64.const 5) (f64.const 3) (i32.const 264))
    (call $box (i32.const 4) (f64.const 2.9) (f64.const -6) (f64.const 1.6) (f64.const 0.2) (f64.const 5) (f64.const 3) (i32.const 264))
    (call $box (i32.const 5) (f64.const -1.95) (f64.const -3.6) (f64.const 1.6) (f64.const 1.9) (f64.const 0.2) (f64.const 3) (i32.const 264))
    (call $box (i32.const 6) (f64.const 1.95) (f64.const -3.6) (f64.const 1.6) (f64.const 1.9) (f64.const 0.2) (f64.const 3) (i32.const 264))
    (call $box (i32.const 7) (f64.const 0) (f64.const -3.6) (f64.const 1.4) (f64.const 1.9) (f64.const 0.12) (f64.const 2.6) (i32.const 272))
    (call $set_text (i32.const 7) (i32.const 152) (i32.const 5) (i32.const 344) (i32.const 4))
    (call $set_text (i32.const 7) (i32.const 216) (i32.const 10) (i32.const 232) (i32.const 3))
    (call $set (i32.const 7) (i32.const 192) (i32.const 10) (f64.const 0.05))
    (call $set (i32.const 7) (i32.const 176) (i32.const 10) (f64.const 140))
    (call $set_bool (i32.const 7) (i32.const 208) (i32.const 8) (i32.const 0))
    (call $set (i32.const 8) (i32.const 24) (i32.const 5) (f64.const 0))
    (call $set (i32.const 8) (i32.const 32) (i32.const 5) (f64.const -6))
    (call $set (i32.const 8) (i32.const 40) (i32.const 5) (f64.const 2.9))
    (call $set (i32.const 8) (i32.const 240) (i32.const 4) (f64.const 0.22))
    (call $set_text (i32.const 8) (i32.const 72) (i32.const 5) (i32.const 280) (i32.const 7))
    (call $box (i32.const 9) (f64.const 2.1) (f64.const -4.4) (f64.const 0.65) (f64.const 0.4) (f64.const 0.4) (f64.const 1.1) (i32.const 288))
    (call $set_text (i32.const 9) (i32.const 152) (i32.const 5) (i32.const 336) (i32.const 6))
    (call $set (i32.const 9) (i32.const 176) (i32.const 10) (f64.const 1400))
    (call $set (i32.const 9) (i32.const 192) (i32.const 10) (f64.const 0.2))
    (call $set_text (i32.const 9) (i32.const 216) (i32.const 10) (i32.const 360) (i32.const 6))
    (call $set_bool (i32.const 9) (i32.const 208) (i32.const 8) (i32.const 0))
    (call $box (i32.const 10) (f64.const -1.6) (f64.const -7.6) (f64.const 0.45) (f64.const 1.8) (f64.const 0.9) (f64.const 0.7) (i32.const 296))
    (call $box (i32.const 11) (f64.const -1.6) (f64.const -7.95) (f64.const 1.25) (f64.const 1.0) (f64.const 0.08) (f64.const 0.7) (i32.const 304))
    (call $set (i32.const 11) (i32.const 88) (i32.const 4) (f64.const 0.6))
    (call $set (i32.const 11) (i32.const 192) (i32.const 10) (f64.const 0.08))
    (call $set_text (i32.const 11) (i32.const 216) (i32.const 10) (i32.const 360) (i32.const 6))
    (call $set_bool (i32.const 11) (i32.const 208) (i32.const 8) (i32.const 0))
    (call $set (i32.const 0) (i32.const 0) (i32.const 5) (f64.const 1)))

  (func (export "tick")
    (local $me i64) (local $i i32) (local $t f64) (local $a f64) (local $d f64) (local $lamp f64)
    (local.set $me (call $self))
    (if (i32.eqz (call $kind (local.get $me) (i32.const 0) (i32.const 5)))
      (then (call $build) (call $show) (return)))
    (local.set $i (i32.const -1))
    (block $done
      (loop $next
        (local.set $i (call $find (i32.const 104) (i32.const 3) (call $entity (i32.const 7)) (local.get $i)))
        (br_if $done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $t (if (result f64) (call $kind (local.get $me) (i32.const 120) (i32.const 6))
          (then (call $get (local.get $me) (i32.const 120) (i32.const 6))) (else (f64.const 0))))
        (call $set (i32.const 0) (i32.const 120) (i32.const 6) (f64.sub (f64.const 1) (local.get $t)))
        (br $next)))
    (local.set $i (i32.const -1))
    (block $done
      (loop $next
        (local.set $i (call $find (i32.const 104) (i32.const 3) (call $entity (i32.const 9)) (local.get $i)))
        (br_if $done (i32.lt_s (local.get $i) (i32.const 0)))
        (local.set $lamp (if (result f64) (call $kind (local.get $me) (i32.const 136) (i32.const 4))
          (then (call $get (local.get $me) (i32.const 136) (i32.const 4))) (else (f64.const 0))))
        (call $set (i32.const 0) (i32.const 136) (i32.const 4) (f64.sub (f64.const 1) (local.get $lamp)))
        (call $set_bool (i32.const 9) (i32.const 208) (i32.const 8) (i32.const 1))
        (call $set (i32.const 0) (i32.const 144) (i32.const 5) (f64.add (f64.convert_i64_s (call $tick)) (f64.const 1)))
        (br $next)))
    (local.set $i (i32.const -1))
    (block $done
      (loop $next
        (local.set $i (call $find (i32.const 112) (i32.const 3) (call $entity (i32.const 11)) (local.get $i)))
        (br_if $done (i32.lt_s (local.get $i) (i32.const 0)))
        (call $key (i32.trunc_f64_s (call $signal_value (local.get $i))))
        (call $show)
        (br $next)))
    (if (call $kind (local.get $me) (i32.const 144) (i32.const 5))
      (then (if (f64.gt (f64.convert_i64_s (call $tick)) (call $get (local.get $me) (i32.const 144) (i32.const 5)))
        (then
          (call $set_bool (i32.const 9) (i32.const 208) (i32.const 8) (i32.const 0))
          (call $set_bool (i32.const 11) (i32.const 208) (i32.const 8) (i32.const 0))))))
    (local.set $lamp (if (result f64) (call $kind (local.get $me) (i32.const 136) (i32.const 4))
      (then (call $get (local.get $me) (i32.const 136) (i32.const 4))) (else (f64.const 0))))
    (call $set (i32.const 8) (i32.const 88) (i32.const 4) (f64.add (f64.mul (local.get $lamp) (f64.const 1.4)) (f64.const 0.05)))
    (call $set (i32.const 8) (i32.const 96) (i32.const 5) (f64.mul (local.get $lamp) (f64.const 9)))
    (local.set $t (f64.mul (f64.const 1.45)
      (if (result f64) (call $kind (local.get $me) (i32.const 120) (i32.const 6))
        (then (call $get (local.get $me) (i32.const 120) (i32.const 6))) (else (f64.const 0)))))
    (local.set $a (if (result f64) (call $kind (local.get $me) (i32.const 128) (i32.const 6))
      (then (call $get (local.get $me) (i32.const 128) (i32.const 6))) (else (f64.const 0))))
    (local.set $d (f64.sub (local.get $t) (local.get $a)))
    (if (f64.gt (f64.abs (local.get $d)) (f64.const 0.001))
      (then
        (local.set $a (f64.add (local.get $a) (f64.max (f64.const -0.12) (f64.min (f64.const 0.12) (local.get $d)))))
        (call $set (i32.const 0) (i32.const 128) (i32.const 6) (local.get $a))
        (call $place_door (local.get $a))
        (call $set (i32.const 7) (i32.const 176) (i32.const 10) (f64.add (f64.const 120) (f64.mul (local.get $a) (f64.const 70))))
        (call $set_bool (i32.const 7) (i32.const 208) (i32.const 8) (i32.const 1)))
      (else (call $set_bool (i32.const 7) (i32.const 208) (i32.const 8) (i32.const 0))))))
