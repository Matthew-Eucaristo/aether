  (func $spend (param $key f64) (param $want f64) (result f64)
    (local $i i32) (local $p i32) (local $got f64)
    (block $found
      (loop $scan
        (br_if $found (i32.ge_u (local.get $i) (global.get $na)))
        (local.set $p (i32.add (global.get $AMMO) (i32.shl (local.get $i) (i32.const 4))))
        (if (f64.eq (f64.load (local.get $p)) (local.get $key))
          (then
