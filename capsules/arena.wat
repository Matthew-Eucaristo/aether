  (func $solid (param $b i64) (result i32)
    (if (i32.ne (call $kind (local.get $b) (i32.const 152) (i32.const 5)) (i32.const 2)) (then (return (i32.const 0))))
    (if (i32.ne (call $get_text (local.get $b) (i32.const 152) (i32.const 5) (i32.const 704) (i32.const 8)) (i32.const 3))
