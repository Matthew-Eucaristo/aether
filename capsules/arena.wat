  (func $hurt (param $i i32) (param $amount f64) (param $from f64) (param $key f64)
    (local $e i32) (local $j i32) (local $o i32) (local $h f64)
    (local.set $e (call $entry (local.get $i)))
    (if (f64.gt (f64.load offset=40 (local.get $e)) (f64.const 0)) (then (return)))
    (local.set $amount (call $spend (local.get $key) (local.get $amount)))
    (if (f64.le (local.get $amount) (f64.const 0)) (then (return)))
    (local.set $h (f64.sub (f64.load offset=16 (local.get $e)) (local.get $amount)))
    (if (f64.gt (local.get $h) (f64.const 0))
      (then (f64.store offset=16 (local.get $e) (local.get $h)) (return)))
    (f64.store offset=16 (local.get $e) (f64.const 0))
    (f64.store offset=32 (local.get $e) (f64.add (f64.load offset=32 (local.get $e)) (f64.const 1)))
