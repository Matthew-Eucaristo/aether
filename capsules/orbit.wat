(module
  (import "world" "self" (func $self (result i64)))
  (import "world" "entity" (func $entity (param i32) (result i64)))
  (import "world" "kind" (func $kind (param i64 i32 i32) (result i32)))
  (import "world" "get_num" (func $get (param i64 i32 i32) (result f64)))
  (import "world" "set_num" (func $set (param i32 i32 i32 f64)))
  (import "world" "set_text" (func $set_text (param i32 i32 i32 i32 i32)))
  (import "world" "spawn" (func $spawn (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "ball")
  (data (i32.const 8) "pos.x")
  (data (i32.const 16) "pos.y")
  (data (i32.const 24) "color")
  (data (i32.const 32) "#e0a030")
  (func (export "tick")
    (local $me i64) (local $ball i32) (local $id i64) (local $x f64) (local $y f64)
    (local.set $me (call $self))
    (if (i32.eqz (call $kind (local.get $me) (i32.const 0) (i32.const 4)))
      (then
        (local.set $ball (call $spawn))
        (call $set (i32.const 0) (i32.const 0) (i32.const 4) (f64.convert_i32_s (local.get $ball)))
        (call $set (local.get $ball) (i32.const 8) (i32.const 5) (f64.const 3))
        (call $set (local.get $ball) (i32.const 16) (i32.const 5) (f64.const 0))
        (call $set_text (local.get $ball) (i32.const 24) (i32.const 5) (i32.const 32) (i32.const 7))))
    (local.set $ball (i32.trunc_f64_s (call $get (local.get $me) (i32.const 0) (i32.const 4))))
    (local.set $id (call $entity (local.get $ball)))
    (local.set $x (call $get (local.get $id) (i32.const 8) (i32.const 5)))
    (local.set $y (call $get (local.get $id) (i32.const 16) (i32.const 5)))
    (call $set (local.get $ball) (i32.const 8) (i32.const 5)
      (f64.sub (f64.mul (local.get $x) (f64.const 0.9950041652780258))
               (f64.mul (local.get $y) (f64.const 0.09983341664682815))))
    (call $set (local.get $ball) (i32.const 16) (i32.const 5)
      (f64.add (f64.mul (local.get $x) (f64.const 0.09983341664682815))
               (f64.mul (local.get $y) (f64.const 0.9950041652780258))))))
