        (br $scan)))
    (i32.const -1))

  (func $place (param $h i32) (param $x f64) (param $y f64) (param $z f64)
    (call $set (local.get $h) (i32.const 32) (i32.const 5) (local.get $x))
    (call $set (local.get $h) (i32.const 40) (i32.const 5) (local.get $y))
    (call $set (local.get $h) (i32.const 48) (i32.const 5) (local.get $z)))

  (func $homes (result i32)
    (i32.div_u (call $nums (global.get $me) (i32.const 616) (i32.const 5) (global.get $HOMES)
      (i32.mul (global.get $MAXHOMES) (i32.const 3))) (i32.const 3)))

  (func $home_of (param $key f64) (param $count i32) (result i32)
    (local $j i32)
    (block $none
      (loop $scan
        (br_if $none (i32.ge_u (local.get $j) (local.get $count)))
        (if (f64.eq (f64.load (i32.add (global.get $HOMES) (i32.mul (local.get $j) (i32.const 24)))) (local.get $key))
          (then (return (local.get $j))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $scan)))
    (i32.const -1))

  (func $key (param $i i32) (result f64)
    (call $hash (global.get $C) (call $player (local.get $i) (global.get $C))))

  (func $set_home (param $i i32)
    (local $count i32) (local $j i32) (local $q i32) (local $e i32)
    (local.set $e (call $entry (local.get $i)))
    (local.set $count (call $homes))
    (local.set $j (call $home_of (call $key (local.get $i)) (local.get $count)))
    (if (i32.lt_s (local.get $j) (i32.const 0))
      (then
        (if (i32.ge_u (local.get $count) (global.get $MAXHOMES))
          (then
            (memory.copy (global.get $HOMES) (i32.add (global.get $HOMES) (i32.const 24))
              (i32.mul (i32.sub (local.get $count) (i32.const 1)) (i32.const 24)))
            (local.set $count (i32.sub (local.get $count) (i32.const 1)))))
        (local.set $j (local.get $count))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))))
    (local.set $q (i32.add (global.get $HOMES) (i32.mul (local.get $j) (i32.const 24))))
    (f64.store (local.get $q) (call $key (local.get $i)))
    (f64.store offset=8 (local.get $q) (f64.load offset=56 (local.get $e)))
    (f64.store offset=16 (local.get $q) (f64.load offset=64 (local.get $e)))
    (call $set_nums (i32.const 0) (i32.const 616) (i32.const 5) (global.get $HOMES) (i32.mul (local.get $count) (i32.const 3))))

  (func $visit (param $i i32) (param $target f64)
    (local $j i32) (local $e i32) (local $f i32)
    (local.set $j (call $index (local.get $target)))
    (local.set $e (call $entry (local.get $i)))
    (if (i32.or (i32.lt_s (local.get $j) (i32.const 0)) (i32.eq (local.get $j) (local.get $i))) (then (return)))
    (if (f64.gt (f64.load offset=48 (local.get $e)) (f64.const 0)) (then (return)))
    (local.set $f (call $entry (local.get $j)))
    (call $move_to (local.get $i) (f64.load offset=144 (local.get $f)))
    (f64.store offset=56 (local.get $e) (f64.add (f64.load offset=56 (local.get $f)) (f64.const 1.5)))
    (f64.store offset=64 (local.get $e) (f64.load offset=64 (local.get $f)))
    (f64.store offset=72 (local.get $e)
      (f64.add (call $floor (f64.load offset=56 (local.get $e)) (f64.load offset=64 (local.get $e)) (f64.load offset=144 (local.get $e))) (f64.const 0.9)))
    (f64.store offset=80 (local.get $e) (f64.const 0))
    (f64.store offset=128 (local.get $e) (f64.const 1)))

  (func $move_to (param $i i32) (param $dim f64)
    (local $e i32)
    (local.set $e (call $entry (local.get $i)))
    (if (f64.eq (f64.load offset=144 (local.get $e)) (local.get $dim)) (then (return)))
    (f64.store offset=144 (local.get $e) (local.get $dim))
    (call $set (i32.trunc_sat_f64_s (f64.load offset=8 (local.get $e))) (i32.const 624) (i32.const 3) (local.get $dim))
    (call $set (i32.trunc_sat_f64_s (f64.load offset=16 (local.get $e))) (i32.const 624) (i32.const 3) (local.get $dim)))

  (func $enter (param $i i32) (param $v f64)
    (local $e i32) (local $a f64) (local $r f64)
    (local.set $e (call $entry (local.get $i)))
    (if (f64.gt (f64.load offset=48 (local.get $e)) (f64.const 0)) (then (return)))
    (call $move_to (local.get $i) (f64.floor (call $clamp (local.get $v) (f64.const 0) (f64.const 1000000))))
    (local.set $a (f64.mul (call $rand) (f64.const 6.283185307179586)))
    (local.set $r (f64.add (f64.const 2) (f64.mul (call $rand) (f64.const 4))))
    (f64.store offset=56 (local.get $e) (f64.mul (local.get $r) (call $cos (local.get $a))))
    (f64.store offset=64 (local.get $e) (f64.mul (local.get $r) (call $sin (local.get $a))))
    (f64.store offset=72 (local.get $e)
      (f64.add (call $floor (f64.load offset=56 (local.get $e)) (f64.load offset=64 (local.get $e)) (f64.load offset=144 (local.get $e))) (f64.const 0.9)))
    (f64.store offset=80 (local.get $e) (f64.const 0))
    (f64.store offset=128 (local.get $e) (f64.const 1)))

  (func $respawn (param $i i32)
    (local $a f64) (local $r f64) (local $e i32) (local $j i32) (local $q i32) (local $cx f64) (local $cy f64)
    (local.set $e (call $entry (local.get $i)))
    (local.set $j (call $home_of (call $key (local.get $i)) (call $homes)))
    (local.set $r (f64.add (f64.const 2) (f64.mul (call $rand) (f64.const 4))))
    (if (i32.ge_s (local.get $j) (i32.const 0))
      (then
        (local.set $q (i32.add (global.get $HOMES) (i32.mul (local.get $j) (i32.const 24))))
        (local.set $cx (f64.load offset=8 (local.get $q)))
        (local.set $cy (f64.load offset=16 (local.get $q)))
        (local.set $r (f64.mul (call $rand) (f64.const 1.5)))))
    (local.set $a (f64.mul (call $rand) (f64.const 6.283185307179586)))
    (f64.store offset=56 (local.get $e) (f64.add (local.get $cx) (f64.mul (local.get $r) (call $cos (local.get $a)))))
    (f64.store offset=64 (local.get $e) (f64.add (local.get $cy) (f64.mul (local.get $r) (call $sin (local.get $a)))))
    (f64.store offset=72 (local.get $e)
      (f64.add (call $floor (f64.load offset=56 (local.get $e)) (f64.load offset=64 (local.get $e)) (f64.load offset=144 (local.get $e))) (f64.const 0.9)))
    (f64.store offset=80 (local.get $e) (f64.const 0))
    (f64.store offset=24 (local.get $e) (f64.const 100))
    (f64.store offset=128 (local.get $e) (f64.const 1)))

  (func $spend (param $key f64) (param $want f64) (result f64)
    (local $i i32) (local $p i32) (local $got f64)
    (block $found
      (loop $scan
        (br_if $found (i32.ge_u (local.get $i) (global.get $na)))
        (local.set $p (i32.add (global.get $AMMO) (i32.shl (local.get $i) (i32.const 4))))
        (if (f64.eq (f64.load (local.get $p)) (local.get $key))
          (then
            (local.set $got (f64.min (local.get $want) (f64.load offset=8 (local.get $p))))
            (f64.store offset=8 (local.get $p) (f64.sub (f64.load offset=8 (local.get $p)) (local.get $got)))
            (return (local.get $got))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
