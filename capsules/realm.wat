  (func $num (param $id i64) (param $k i32) (param $l i32) (param $d f64) (result f64)
    (if (result f64) (i32.eq (call $kind (local.get $id) (local.get $k) (local.get $l)) (i32.const 1))
      (then (call $get (local.get $id) (local.get $k) (local.get $l)))
      (else (local.get $d))))

  (func $nums (param $id i64) (param $k i32) (param $l i32) (param $dst i32) (param $max i32) (result i32)
    (local $c i32)
    (if (i32.ne (call $kind (local.get $id) (local.get $k) (local.get $l)) (i32.const 4)) (then (return (i32.const 0))))
    (local.set $c (call $get_nums (local.get $id) (local.get $k) (local.get $l) (local.get $dst) (local.get $max)))
    (select (i32.const 0) (local.get $c) (i32.gt_u (local.get $c) (local.get $max))))

  (func $text (param $id i64) (param $k i32) (param $l i32) (param $dst i32) (result i32)
    (local $len i32)
    (if (i32.ne (call $kind (local.get $id) (local.get $k) (local.get $l)) (i32.const 2)) (then (return (i32.const -1))))
    (local.set $len (call $get_text (local.get $id) (local.get $k) (local.get $l) (local.get $dst) (i32.const 64)))
    (select (i32.const -1) (local.get $len) (i32.gt_s (local.get $len) (i32.const 64))))

  (func $clamp (param $v f64) (param $lo f64) (param $hi f64) (result f64)
    (f64.min (f64.max (local.get $v) (local.get $lo)) (local.get $hi)))

  (func $rand (result f64)
    (f64.mul (f64.convert_i64_u (i64.shr_u (call $random) (i64.const 11))) (f64.const 1.1102230246251565e-16)))

  (func $entry (param $i i32) (result i32)
    (i32.add (global.get $ROSTER) (i32.mul (local.get $i) (global.get $STRIDE))))

  (func $solid (param $i i32) (result i32)
    (i32.add (global.get $SOLIDS) (i32.shl (local.get $i) (i32.const 7))))

  (func $eq (param $p i32) (param $pl i32) (param $q i32) (param $ql i32) (result i32)
    (local $i i32)
    (if (i32.or (i32.ne (local.get $pl) (local.get $ql))
                (i32.or (i32.lt_s (local.get $pl) (i32.const 0)) (i32.gt_s (local.get $pl) (i32.const 64))))
      (then (return (i32.const 0))))
    (block $diff
      (loop $cmp
        (br_if $diff (i32.ge_u (local.get $i) (local.get $pl)))
        (if (i32.ne (i32.load8_u (i32.add (local.get $p) (local.get $i))) (i32.load8_u (i32.add (local.get $q) (local.get $i))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $cmp)))
    (i32.const 1))

  (func $itoa (param $v i32) (param $p i32) (result i32)
    (local $len i32) (local $t i32) (local $i i32)
    (if (i32.le_s (local.get $v) (i32.const 0))
      (then (i32.store8 (local.get $p) (i32.const 48)) (return (i32.add (local.get $p) (i32.const 1)))))
    (local.set $t (local.get $v))
    (loop $count
      (local.set $len (i32.add (local.get $len) (i32.const 1)))
      (local.set $t (i32.div_u (local.get $t) (i32.const 10)))
      (br_if $count (local.get $t)))
    (local.set $i (local.get $len))
    (local.set $t (local.get $v))
    (loop $write
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (i32.store8 (i32.add (local.get $p) (local.get $i)) (i32.add (i32.const 48) (i32.rem_u (local.get $t) (i32.const 10))))
      (local.set $t (i32.div_u (local.get $t) (i32.const 10)))
      (br_if $write (local.get $i)))
    (i32.add (local.get $p) (local.get $len)))

  (func $copy (param $dst i32) (param $src i32) (param $len i32) (result i32)
    (if (i32.le_s (local.get $len) (i32.const 0)) (then (return (local.get $dst))))
    (memory.copy (local.get $dst) (local.get $src) (local.get $len))
    (i32.add (local.get $dst) (local.get $len)))

  (func $hash (param $p i32) (param $len i32) (result f64)
    (local $h i32) (local $i i32)
    (local.set $h (i32.const 0x811c9dc5))
    (if (i32.or (i32.lt_s (local.get $len) (i32.const 0)) (i32.gt_s (local.get $len) (i32.const 64)))
      (then (local.set $len (i32.const 0))))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $h (i32.mul (i32.xor (local.get $h) (i32.load8_u (i32.add (local.get $p) (local.get $i)))) (i32.const 0x01000193)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $next)))
    (f64.convert_i32_u (local.get $h)))

  (func $avatar (param $i i32) (result i64)
    (i64.trunc_sat_f64_s (f64.load (call $entry (local.get $i)))))

  (func $player (param $i i32) (param $dst i32) (result i32)
    (call $text (call $avatar (local.get $i)) (i32.const 424) (i32.const 6) (local.get $dst)))

  (func $name (param $i i32) (param $dst i32) (result i32)
    (local $len i32)
    (local.set $len (call $player (local.get $i) (global.get $C)))
    (if (i32.le_s (local.get $len) (i32.const 7)) (then (return (local.get $dst))))
    (call $copy (local.get $dst) (i32.add (global.get $C) (i32.const 7)) (i32.sub (local.get $len) (i32.const 7))))

  (func $index (param $av f64) (result i32)
    (local $i i32)
    (block $none
      (loop $scan
        (br_if $none (i32.ge_u (local.get $i) (global.get $n)))
        (if (f64.eq (f64.load (call $entry (local.get $i))) (local.get $av)) (then (return (local.get $i))))
