        (i32.store8 (local.get $q) (i32.const 47))
        (local.set $q (call $itoa (i32.trunc_sat_f64_s (f64.load offset=40 (local.get $e))) (i32.add (local.get $q) (i32.const 1))))
        (i32.store8 (local.get $q) (i32.const 10))
        (local.set $q (i32.add (local.get $q) (i32.const 1)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $each)))
    (call $set_text (i32.const 0) (i32.const 144) (i32.const 5) (global.get $TEXT) (i32.sub (local.get $q) (global.get $TEXT))))

  (func (export "tick")
    (local $i i32) (local $e i32)
    (global.set $me (call $self))
    (if (i32.eqz (call $kind (global.get $me) (i32.const 0) (i32.const 5)))
      (then
        (call $set_bool (i32.const 0) (i32.const 0) (i32.const 5) (i32.const 1))
        (call $set_text (i32.const 0) (i32.const 152) (i32.const 5) (i32.const 160) (i32.const 3))
        (call $place (i32.const 0) (f64.const 9) (f64.const 9) (f64.const 1.2))
        (call $set (i32.const 0) (i32.const 168) (i32.const 7) (f64.const 0.3))
        (call $set (i32.const 0) (i32.const 176) (i32.const 7) (f64.const 2.4))
        (call $set (i32.const 0) (i32.const 184) (i32.const 7) (f64.const 2.4))
        (call $set (i32.const 0) (i32.const 216) (i32.const 4) (f64.const 0.25))
        (call $set_text (i32.const 0) (i32.const 192) (i32.const 5) (i32.const 296) (i32.const 7))
        (global.set $board (i32.const 1))))
    (global.set $n (i32.div_u (call $nums (global.get $me) (i32.const 128) (i32.const 6) (global.get $ROSTER) (i32.const 640)) (global.get $FIELDS)))
    (call $ammo)
    (global.set $ns (i32.const 0))
    (call $join)
    (call $arena)
    (block $done
      (loop $each
        (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
        (local.set $e (call $entry (local.get $i)))
        (call $inputs (local.get $i))
        (if (f64.gt (f64.load offset=136 (local.get $e)) (f64.const 0))
          (then
            (call $despawn (i32.trunc_sat_f64_s (f64.load offset=8 (local.get $e))))
            (call $despawn (i32.trunc_sat_f64_s (f64.load offset=16 (local.get $e))))
            (global.set $n (i32.sub (global.get $n) (i32.const 1)))
            (memory.copy (local.get $e) (call $entry (global.get $n)) (global.get $STRIDE))
            (global.set $board (i32.const 1))
            (br $each)))
        (if (f64.gt (f64.load offset=48 (local.get $e)) (f64.const 0))
          (then
            (f64.store offset=48 (local.get $e) (f64.sub (f64.load offset=48 (local.get $e)) (f64.const 1)))
            (f64.store offset=128 (local.get $e) (f64.const 1))
            (call $set (i32.trunc_sat_f64_s (f64.load offset=8 (local.get $e))) (i32.const 456) (i32.const 6) (f64.const 0))
            (if (f64.le (f64.load offset=48 (local.get $e)) (f64.const 0))
              (then
                (call $set (i32.trunc_sat_f64_s (f64.load offset=8 (local.get $e))) (i32.const 456) (i32.const 6) (f64.const 1))
                (call $respawn (local.get $i))))))
        (call $move (local.get $i))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $each)))
    (call $projectiles)
    (local.set $i (i32.const 0))
    (block $shown
      (loop $each
        (br_if $shown (i32.ge_u (local.get $i) (global.get $n)))
        (call $vitals (local.get $i))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $each)))
    (call $scoreboard)
    (call $set_nums (i32.const 0) (i32.const 128) (i32.const 6) (global.get $ROSTER) (i32.mul (global.get $n) (global.get $FIELDS)))
    (call $set_nums (i32.const 0) (i32.const 240) (i32.const 4) (global.get $AMMO) (i32.shl (global.get $na) (i32.const 1)))))
