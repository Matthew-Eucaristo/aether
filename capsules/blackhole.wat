(module
  (import "world" "self" (func $self (result i64)))
  (import "world" "entity" (func $entity (param i32) (result i64)))
  (import "world" "kind" (func $kind (param i64 i32 i32) (result i32)))
  (import "world" "get_num" (func $get (param i64 i32 i32) (result f64)))
  (import "world" "get_nums" (func $get_nums (param i64 i32 i32 i32 i32) (result i32)))
  (import "world" "set_num" (func $set (param i32 i32 i32 f64)))
  (import "world" "set_nums" (func $set_nums (param i32 i32 i32 i32 i32)))
  (import "world" "set_text" (func $set_text (param i32 i32 i32 i32 i32)))
  (import "world" "spawn" (func $spawn (result i32)))
  (import "world" "random" (func $random (result i64)))
  (memory (export "memory") 20)
  (data (i32.const 0) "disk")
  (data (i32.const 8) "points")
  (data (i32.const 16) "pos.x")
  (data (i32.const 24) "pos.y")
  (data (i32.const 32) "pos.z")
  (data (i32.const 40) "color")
  (data (i32.const 48) "#ffb347")
  (data (i32.const 56) "size")
  (data (i32.const 64) "#000000")
  (data (i32.const 72) "look")
  (data (i32.const 80) "blackhole")
  (data (i32.const 96) "accretion")
  (global $count i32 (i32.const 50000))
  (global $base i32 (i32.const 1024))

  (func $rand (result f64)
    (f64.mul
      (f64.convert_i64_u (i64.shr_u (call $random) (i64.const 11)))
      (f64.const 1.1102230246251565e-16)))

  (func $place (param $h i32) (param $z f64) (param $size f64)
    (call $set (local.get $h) (i32.const 16) (i32.const 5) (f64.const 0))
    (call $set (local.get $h) (i32.const 24) (i32.const 5) (f64.const 14))
    (call $set (local.get $h) (i32.const 32) (i32.const 5) (local.get $z))
    (call $set (local.get $h) (i32.const 56) (i32.const 4) (local.get $size)))

  (func $emit (param $i i32) (param $dx f64) (param $dy f64) (param $r f64)
    (local $len f64) (local $p i32)
    (local.set $len (f64.sqrt (f64.add (f64.mul (local.get $dx) (local.get $dx))
                                       (f64.mul (local.get $dy) (local.get $dy)))))
    (if (f64.lt (local.get $len) (f64.const 1e-9))
      (then (local.set $dx (f64.const 1)) (local.set $dy (f64.const 0)) (local.set $len (f64.const 1))))
    (local.set $p (i32.add (global.get $base) (i32.mul (local.get $i) (i32.const 24))))
    (f64.store (local.get $p) (f64.mul (f64.div (local.get $dx) (local.get $len)) (local.get $r)))
    (f64.store offset=8 (local.get $p) (f64.mul (f64.div (local.get $dy) (local.get $len)) (local.get $r)))
    (f64.store offset=16 (local.get $p) (f64.mul (f64.sub (call $rand) (f64.const 0.5)) (f64.const 0.4))))

  (func (export "tick")
    (local $me i64) (local $disk i32) (local $core i32) (local $i i32) (local $p i32) (local $n i32)
    (local $x f64) (local $y f64) (local $r f64) (local $w f64) (local $nx f64) (local $ny f64) (local $s f64)
    (local.set $me (call $self))
    (if (i32.eqz (call $kind (local.get $me) (i32.const 0) (i32.const 4)))
      (then
        (local.set $core (call $spawn))
        (call $place (local.get $core) (f64.const 5) (f64.const 1))
        (call $set_text (local.get $core) (i32.const 40) (i32.const 5) (i32.const 64) (i32.const 7))
        (call $set_text (local.get $core) (i32.const 72) (i32.const 4) (i32.const 80) (i32.const 9))
        (local.set $disk (call $spawn))
        (call $place (local.get $disk) (f64.const 5) (f64.const 0.035))
        (call $set_text (local.get $disk) (i32.const 40) (i32.const 5) (i32.const 48) (i32.const 7))
        (call $set_text (local.get $disk) (i32.const 72) (i32.const 4) (i32.const 96) (i32.const 9))
        (call $set (i32.const 0) (i32.const 0) (i32.const 4) (f64.convert_i32_s (local.get $disk)))
        (loop $fill
          (call $emit (local.get $i)
            (f64.sub (call $rand) (f64.const 0.5))
            (f64.sub (call $rand) (f64.const 0.5))
            (f64.add (f64.const 2.5) (f64.mul (call $rand) (f64.const 6.5))))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br_if $fill (i32.lt_u (local.get $i) (global.get $count))))
        (call $set_nums (local.get $disk) (i32.const 8) (i32.const 6) (global.get $base)
          (i32.mul (global.get $count) (i32.const 3)))
        (return)))
    (local.set $disk (i32.trunc_f64_s (call $get (local.get $me) (i32.const 0) (i32.const 4))))
    (local.set $n (i32.div_u
      (call $get_nums (call $entity (local.get $disk)) (i32.const 8) (i32.const 6)
        (global.get $base) (i32.mul (global.get $count) (i32.const 3)))
      (i32.const 3)))
    (if (i32.gt_u (local.get $n) (global.get $count)) (then (local.set $n (global.get $count))))
    (local.set $i (i32.const 0))
    (block $done
      (loop $step
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $p (i32.add (global.get $base) (i32.mul (local.get $i) (i32.const 24))))
        (local.set $x (f64.load (local.get $p)))
        (local.set $y (f64.load offset=8 (local.get $p)))
        (local.set $r (f64.sqrt (f64.add (f64.mul (local.get $x) (local.get $x))
                                         (f64.mul (local.get $y) (local.get $y)))))
        (local.set $w (f64.div (f64.const 0.35) (f64.mul (local.get $r) (f64.sqrt (local.get $r)))))
        (local.set $nx (f64.sub (local.get $x) (f64.mul (local.get $y) (local.get $w))))
        (local.set $ny (f64.add (local.get $y) (f64.mul (local.get $x) (local.get $w))))
        (local.set $r (f64.mul (local.get $r) (f64.const 0.9975)))
        (if (f64.lt (local.get $r) (f64.const 1.15))
          (then
            (call $emit (local.get $i) (local.get $nx) (local.get $ny)
              (f64.add (f64.const 7) (f64.mul (call $rand) (f64.const 2)))))
          (else
            (local.set $s (f64.div (local.get $r)
              (f64.sqrt (f64.add (f64.mul (local.get $nx) (local.get $nx))
                                 (f64.mul (local.get $ny) (local.get $ny))))))
            (f64.store (local.get $p) (f64.mul (local.get $nx) (local.get $s)))
            (f64.store offset=8 (local.get $p) (f64.mul (local.get $ny) (local.get $s)))
            (f64.store offset=16 (local.get $p) (f64.mul (f64.load offset=16 (local.get $p)) (f64.const 0.97)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $step)))
    (call $set_nums (local.get $disk) (i32.const 8) (i32.const 6) (global.get $base)
      (i32.mul (local.get $n) (i32.const 3)))))
