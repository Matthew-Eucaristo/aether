(module
  (import "world" "self" (func $self (result i64)))
  (import "world" "kind" (func $kind (param i64 i32 i32) (result i32)))
  (import "world" "get_num" (func $get (param i64 i32 i32) (result f64)))
  (import "world" "get_text" (func $get_text (param i64 i32 i32 i32 i32) (result i32)))
  (import "world" "get_nums" (func $get_nums (param i64 i32 i32 i32 i32) (result i32)))
  (import "world" "set_num" (func $set (param i32 i32 i32 f64)))
  (import "world" "set_text" (func $set_text (param i32 i32 i32 i32 i32)))
  (import "world" "set_nums" (func $set_nums (param i32 i32 i32 i32 i32)))
  (import "world" "signal_find" (func $signal_find (param i32 i32 i64 i32) (result i32)))
  (import "world" "signal_name" (func $signal_name (param i32 i32 i32) (result i32)))
  (import "world" "signal_from" (func $signal_from (param i32 i32 i32) (result i32)))
  (import "world" "signal_value" (func $signal_value (param i32) (result f64)))
  (import "world" "award" (func $award (param i32 i64 i32 i32) (result i32)))
  (import "world" "release" (func $release (param i32 i64) (result i32)))
  (import "world" "random" (func $random (result i64)))
  (import "world" "tick" (func $tick (result i64)))
  (import "world" "log" (func $log (param i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "pledge")
  (data (i32.const 8) "pledge_capsule")
  (data (i32.const 24) "p1")
  (data (i32.const 32) "p2")
  (data (i32.const 40) "stakes")
  (data (i32.const 48) "since")
  (data (i32.const 56) "label")
  (data (i32.const 64) "dice wager: pledge a stake to play")
  (data (i32.const 104) " wins every stake")
  (data (i32.const 128) "nobody came: stakes returned")
  (global $FROM i32 (i32.const 256))
  (global $P1 i32 (i32.const 320))
  (global $P2 i32 (i32.const 384))
  (global $NAME i32 (i32.const 448))
  (global $STAKES i32 (i32.const 512))
  (global $MSG i32 (i32.const 768))
  (global $MAX i32 (i32.const 8))
  (global $n (mut i32) (i32.const 0))

  (func $same (param $a i32) (param $al i32) (param $b i32) (param $bl i32) (result i32)
    (local $i i32)
    (if (i32.ne (local.get $al) (local.get $bl)) (then (return (i32.const 0))))
    (block $diff
      (loop $cmp
        (br_if $diff (i32.ge_u (local.get $i) (local.get $al)))
        (if (i32.ne (i32.load8_u (i32.add (local.get $a) (local.get $i)))
                    (i32.load8_u (i32.add (local.get $b) (local.get $i))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $cmp)))
    (i32.const 1))

  (func $text (param $key i32) (param $kl i32) (param $dst i32) (result i32)
    (local $len i32)
    (if (i32.ne (call $kind (call $self) (local.get $key) (local.get $kl)) (i32.const 2)) (then (return (i32.const 0))))
    (local.set $len (call $get_text (call $self) (local.get $key) (local.get $kl) (local.get $dst) (i32.const 64)))
    (select (local.get $len) (i32.const 0) (i32.le_u (local.get $len) (i32.const 64))))

  (func $slot (param $i i32) (result i32)
    (i32.add (global.get $STAKES) (i32.mul (local.get $i) (i32.const 24))))

  (func $settle (param $winner i32) (param $wl i32)
    (local $i i32) (local $q i32)
    (block $done
      (loop $each
        (br_if $done (i32.ge_u (local.get $i) (global.get $n)))
        (local.set $q (call $slot (local.get $i)))
        (if (i32.gt_s (local.get $wl) (i32.const 0))
          (then (drop (call $award (i32.trunc_f64_s (f64.load (local.get $q))) (i64.trunc_f64_s (f64.load offset=8 (local.get $q)))
                  (local.get $winner) (local.get $wl))))
          (else (drop (call $release (i32.trunc_f64_s (f64.load (local.get $q))) (i64.trunc_f64_s (f64.load offset=8 (local.get $q)))))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $each)))
    (global.set $n (i32.const 0)))

  (func (export "tick")
    (local $me i64) (local $s i32) (local $len i32) (local $fl i32) (local $who i32) (local $kind i32)
    (local $l1 i32) (local $l2 i32) (local $since f64) (local $now f64) (local $q i32) (local $w i32) (local $wl i32) (local $dirty i32)
    (local.set $me (call $self))
    (local.set $now (f64.convert_i64_s (call $tick)))
    (global.set $n (i32.const 0))
    (if (i32.eq (call $kind (local.get $me) (i32.const 40) (i32.const 6)) (i32.const 4))
      (then (global.set $n (i32.div_u (call $get_nums (local.get $me) (i32.const 40) (i32.const 6) (global.get $STAKES) (i32.mul (global.get $MAX) (i32.const 3))) (i32.const 3)))))
    (if (i32.gt_u (global.get $n) (global.get $MAX)) (then (global.set $n (i32.const 0))))
    (local.set $l1 (call $text (i32.const 24) (i32.const 2) (global.get $P1)))
    (local.set $l2 (call $text (i32.const 32) (i32.const 2) (global.get $P2)))
    (if (i32.eq (call $kind (local.get $me) (i32.const 48) (i32.const 5)) (i32.const 1))
      (then (local.set $since (call $get (local.get $me) (i32.const 48) (i32.const 5)))))
    (if (i32.eqz (call $kind (local.get $me) (i32.const 56) (i32.const 5)))
      (then (call $set_text (i32.const 0) (i32.const 56) (i32.const 5) (i32.const 64) (i32.const 34))))

    (local.set $s (i32.const -1))
    (block $done
      (loop $next
        (local.set $s (call $signal_find (i32.const 0) (i32.const 0) (local.get $me) (local.get $s)))
        (br_if $done (i32.lt_s (local.get $s) (i32.const 0)))
        (local.set $len (call $signal_name (local.get $s) (global.get $NAME) (i32.const 16)))
        (local.set $kind (i32.const -1))
        (if (call $same (global.get $NAME) (local.get $len) (i32.const 0) (i32.const 6)) (then (local.set $kind (i32.const 0))))
        (if (call $same (global.get $NAME) (local.get $len) (i32.const 8) (i32.const 14)) (then (local.set $kind (i32.const 1))))
        (if (i32.ge_s (local.get $kind) (i32.const 0))
          (then
            (local.set $dirty (i32.const 1))
            (local.set $fl (call $signal_from (local.get $s) (global.get $FROM) (i32.const 64)))
            (local.set $who (i32.const 0))
            (if (i32.gt_u (local.get $fl) (i32.const 64)) (then (local.set $fl (i32.const 0))))
            (if (i32.and (i32.gt_s (local.get $l1) (i32.const 0)) (call $same (global.get $FROM) (local.get $fl) (global.get $P1) (local.get $l1)))
              (then (local.set $who (i32.const 1))))
            (if (i32.and (i32.eqz (local.get $who))
                  (i32.and (i32.gt_s (local.get $l2) (i32.const 0)) (call $same (global.get $FROM) (local.get $fl) (global.get $P2) (local.get $l2))))
              (then (local.set $who (i32.const 2))))
            (if (i32.and (i32.eqz (local.get $who)) (i32.eqz (local.get $l1)))
              (then
                (memory.copy (global.get $P1) (global.get $FROM) (local.get $fl))
                (local.set $l1 (local.get $fl))
                (local.set $since (local.get $now))
                (local.set $who (i32.const 1))))
            (if (i32.and (i32.eqz (local.get $who)) (i32.eqz (local.get $l2)))
              (then
                (memory.copy (global.get $P2) (global.get $FROM) (local.get $fl))
                (local.set $l2 (local.get $fl))
                (local.set $who (i32.const 2))))
            (if (i32.and (i32.gt_s (local.get $who) (i32.const 0)) (i32.lt_u (global.get $n) (global.get $MAX)))
              (then
                (local.set $q (call $slot (global.get $n)))
                (f64.store (local.get $q) (f64.convert_i32_s (local.get $kind)))
                (f64.store offset=8 (local.get $q) (call $signal_value (local.get $s)))
                (f64.store offset=16 (local.get $q) (f64.convert_i32_s (local.get $who)))
                (global.set $n (i32.add (global.get $n) (i32.const 1))))
              (else
                (drop (call $release (local.get $kind) (i64.trunc_sat_f64_s (call $signal_value (local.get $s)))))))))
        (br $next)))

    (if (i32.and (i32.gt_s (local.get $l1) (i32.const 0)) (i32.gt_s (local.get $l2) (i32.const 0)))
      (then
        (local.set $w (select (global.get $P1) (global.get $P2) (i64.eqz (i64.and (call $random) (i64.const 1)))))
        (local.set $wl (select (local.get $l1) (local.get $l2) (i32.eq (local.get $w) (global.get $P1))))
        (call $settle (local.get $w) (local.get $wl))
        (memory.copy (global.get $MSG) (local.get $w) (local.get $wl))
        (memory.copy (i32.add (global.get $MSG) (local.get $wl)) (i32.const 104) (i32.const 17))
        (call $log (global.get $MSG) (i32.add (local.get $wl) (i32.const 17)))
        (local.set $dirty (i32.const 1))
        (local.set $l1 (i32.const 0))
        (local.set $l2 (i32.const 0))))
    (if (i32.and (i32.gt_s (local.get $l1) (i32.const 0))
                 (f64.gt (f64.sub (local.get $now) (local.get $since)) (f64.const 600)))
      (then
        (call $settle (i32.const 0) (i32.const 0))
        (call $log (i32.const 128) (i32.const 28))
        (local.set $dirty (i32.const 1))
        (local.set $l1 (i32.const 0))))
    (if (i32.eqz (local.get $dirty)) (then (return)))

    (call $set_nums (i32.const 0) (i32.const 40) (i32.const 6) (global.get $STAKES) (i32.mul (global.get $n) (i32.const 3)))
    (call $set_text (i32.const 0) (i32.const 24) (i32.const 2) (global.get $P1) (local.get $l1))
    (call $set_text (i32.const 0) (i32.const 32) (i32.const 2) (global.get $P2) (local.get $l2))
    (call $set (i32.const 0) (i32.const 48) (i32.const 5) (local.get $since))))
